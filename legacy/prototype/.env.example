# Em desenvolvimento, o .env é gerado sozinho na primeira execução.
# Em produção, defina as variáveis abaixo no cofre de segredos da hospedagem, nunca em arquivo versionado.

NODE_ENV=production

# Gere cada chave com: openssl rand -base64 32
ESCALA_ENC_KEY=
ESCALA_HMAC_KEY=

# Domínio(s) público(s) do app, separados por vírgula.
APP_ORIGIN=https://app.exemplo.com.br

# Quantidade de proxies confiáveis à frente do servidor (ex.: 1 atrás de um balanceador).
TRUST_PROXY=1

PORT=4173
HOST=0.0.0.0

# Provedor de e-mail, obrigatório em produção. Em produção, o envio exige conexão criptografada (TLS).
SMTP_URL=smtps://usuario:senha@smtp.exemplo.com.br:465
MAIL_FROM=Escala <nao-responda@exemplo.com.br>
