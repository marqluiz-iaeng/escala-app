{
  "name": "@escala/api",
  "version": "0.2.0",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "dev": "nest start --watch --env-file ../../.env",
    "start": "node dist/main.js",
    "lint": "eslint . --max-warnings 0",
    "typecheck": "tsc --noEmit",
    "test": "vitest run --project unit",
    "test:cov": "vitest run --project unit --coverage",
    "test:db": "vitest run --project db",
    "db:bootstrap": "tsx --env-file=../../.env db/cli.ts bootstrap",
    "db:migrate": "tsx --env-file=../../.env db/cli.ts up",
    "db:rollback": "tsx --env-file=../../.env db/cli.ts down",
    "db:seed": "tsx --env-file=../../.env db/seeds/dev.ts",
    "db:dictionary": "tsx --env-file=../../.env db/dictionary-cli.ts",
    "db:pull": "tsx --env-file=../../.env db/pull-cli.ts"
  },
  "dependencies": {
    "@escala/shared": "workspace:*",
    "@nestjs/common": "12.3.3",
    "@nestjs/core": "12.3.3",
    "@nestjs/platform-express": "12.3.3",
    "@nestjs/swagger": "12.1.0",
    "drizzle-orm": "0.45.4",
    "helmet": "8.3.0",
    "nestjs-pino": "5.3.1",
    "node-pg-migrate": "9.0.0",
    "pg": "8.23.1",
    "pino": "10.4.0",
    "pino-http": "11.0.0",
    "reflect-metadata": "0.2.2",
    "rxjs": "7.8.2",
    "zod": "catalog:"
  },
  "devDependencies": {
    "@nestjs/cli": "12.0.11",
    "@nestjs/testing": "12.3.3",
    "@testcontainers/postgresql": "12.2.1",
    "@types/express": "5.0.6",
    "@types/node": "catalog:",
    "@types/pg": "8.23.1",
    "@types/supertest": "7.2.1",
    "drizzle-kit": "0.31.11",
    "eslint": "catalog:",
    "supertest": "7.3.1",
    "testcontainers": "12.2.1",
    "tsx": "4.23.15",
    "typescript": "catalog:",
    "vitest": "catalog:"
  }
}
