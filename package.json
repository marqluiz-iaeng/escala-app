{
  "name": "escala",
  "version": "0.2.0",
  "private": true,
  "type": "module",
  "description": "Marketplace que conecta empresas a freelancers para turnos e trabalhos avulsos.",
  "packageManager": "pnpm@12.16.1",
  "engines": {
    "node": ">=24.3.0 <25"
  },
  "scripts": {
    "setup:env": "node scripts/setup-env.mjs",
    "services:up": "docker compose up -d --wait",
    "services:down": "docker compose down",
    "dev:api": "turbo run dev --filter=@escala/api",
    "dev:mobile": "turbo run dev --filter=@escala/mobile",
    "build": "turbo run build",
    "lint": "turbo run lint",
    "typecheck": "turbo run typecheck",
    "test": "turbo run test",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "verify": "prettier --check . && turbo run lint typecheck test build && turbo run test:db",
    "test:db": "turbo run test:db",
    "db:setup": "pnpm --filter @escala/api db:bootstrap && pnpm --filter @escala/api db:migrate",
    "db:seed": "pnpm --filter @escala/api db:seed"
  },
  "devDependencies": {
    "@eslint/js": "catalog:",
    "eslint": "catalog:",
    "eslint-config-prettier": "catalog:",
    "eslint-plugin-react-hooks": "7.1.1",
    "prettier": "3.10.1",
    "turbo": "2.11.13",
    "typescript": "catalog:",
    "typescript-eslint": "catalog:"
  }
}
