# Gere seu .env local com: pnpm setup:env
# Valores __RANDOM__ são trocados por segredos aleatórios. Nunca versione o .env.
# Em produção, as variáveis vêm do cofre de segredos da hospedagem, não de arquivo.

# --- API ---
NODE_ENV=development
# Só a máquina local. Use 0.0.0.0 apenas atrás de um proxy com TLS.
API_HOST=127.0.0.1
API_PORT=3000
LOG_LEVEL=info
# Origens web liberadas, separadas por vírgula. O app nativo não precisa de CORS.
# http://localhost:8081 é a versão web do Expo, usada só em desenvolvimento.
CORS_ORIGINS=http://localhost:8081

# --- Serviços locais do Docker Compose ---
POSTGRES_USER=escala_owner
POSTGRES_PASSWORD=__RANDOM__
POSTGRES_PORT=5432
POSTGRES_HOST=127.0.0.1
# Banco do app, criado pelo `pnpm db:setup`.
DB_NAME=escala
# Cada parte do sistema entra no banco com um papel próprio e permissões mínimas (ADR-0005).
DB_MIGRATOR_PASSWORD=__RANDOM__
DB_APP_PASSWORD=__RANDOM__
DB_AUTH_PASSWORD=__RANDOM__
DB_WORKER_PASSWORD=__RANDOM__
DB_SUPPORT_PASSWORD=__RANDOM__
DB_ANALYTICS_PASSWORD=__RANDOM__
REDIS_PASSWORD=__RANDOM__
REDIS_PORT=6379
# Caixa de e-mail local: envio em 1025 e tela em http://localhost:8025
MAILPIT_SMTP_PORT=1025
MAILPIT_UI_PORT=8025

# --- Criptografia de campos (ADR-0006). Só para desenvolvimento: em produção, as chaves vêm do KMS ---
# Formato id:base64, separados por vírgula. A primeira cifra; as demais só leem, para permitir a rotação.
FIELD_ENCRYPTION_KEYS=k1:__RANDOM_KEY__
# Chave separada dos índices cegos. Trocar esta chave invalida as buscas por e-mail, CPF e CNPJ.
BLIND_INDEX_KEY=__RANDOM_KEY__
